{
  "name": "autokeep",
  "version": "0.1.0",
  "private": true,
  "description": "AutoKeep - autonomous treasury agent for DAOs, built on KeeperHub",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "agent": "npm run dev --workspace apps/agent"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
