# KeeperHub organization API key (Settings > API Keys on app.keeperhub.com)
KEEPERHUB_API_KEY=kh_your_key_here

# Default network for executions (11155111 = Ethereum Sepolia, 8453 = Base)
AUTOKEEP_NETWORK=11155111

# Treasury wallet address (auto-resolved from KeeperHub org wallet; override to pin)
# AUTOKEEP_TREASURY=0x...
